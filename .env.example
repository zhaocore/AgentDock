# dutybotGo 配置示例；复制为 .env 后填写
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dutybot
MYSQL_PASSWORD=dutybot
MYSQL_DB=dutybot

# Redis（Asynq）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# 仓库克隆根目录（相对路径基于服务进程工作目录）
REPO_ROOT_DIR=repo

# 部署者维护的公共 skills、MCP 配置与 Agent 预设
AGENT_CONFIG_DIR=agents

# LLM（OpenAI 兼容端点，langchaingo 使用）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# 认证
JWT_SECRET=change-me-in-production
