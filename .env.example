# AgentDock 配置示例；复制为 .env 后填写
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agentdock
MYSQL_PASSWORD=agentdock
MYSQL_DB=agentdock

# Redis（Asynq）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# 仓库克隆根目录（相对路径基于服务进程工作目录）
REPO_ROOT_DIR=repo

# 部署者维护的公共 skills、MCP 配置与 Agent 预设
AGENT_CONFIG_DIR=agents

# LLM（OpenAI 兼容端点，langchaingo 使用）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# 认证
JWT_SECRET=change-me-in-production

# Confluence 后台导出（启用时完整配置；Cookie 不回传浏览器）
CONFLUENCE_BASE_URL=
CONFLUENCE_COOKIE=
# 本机运行 Go 使用此地址；compose 中由服务名覆盖
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=agentdock-confluence
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# 定时采集：HTTPS origin 主机须小写，省略默认 443 端口；下例仅为占位配置
# ready_selector 必须指向登录成功且正文加载完成后可见的稳定页面元素
# CRAWL_PROFILES=[{"id":"docs","origin":"https://docs.example.com","cookie":"session=replace-me","user_ids":["11111111-1111-1111-1111-111111111111"],"ready_selector":"[data-testid=authenticated-content]"}]
CRAWL_PROFILES=[]

# 单进程并发限额，整数 1–64；修改后重启。Worker 与仓库、Confluence 共享。
WORKER_CONCURRENCY=4
CRAWL_CAPTURE_CONCURRENCY=3
CRAWL_TASK_CONCURRENCY=3
CRAWL_REPORT_CONCURRENCY=1
